{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "possiblepacking",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [".git", "node_modules"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
